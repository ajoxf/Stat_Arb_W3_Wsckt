# Flask Configuration
FLASK_SECRET_KEY=your-secret-key-here
FLASK_DEBUG=true
PORT=5002

# WebSocket Streaming (set to false to use REST polling instead)
USE_WEBSOCKET=true

# Exchange backend for order placement/cancellation/fill detection
# "rest"      — use OKXAdapter (HTTP REST, ~9 s entry latency)
# "websocket" — use OKXWebSocketAdapter (private-channel WS, target <500 ms)
EXCHANGE_BACKEND=rest

# OKX API Credentials
OKX_API_KEY=your-okx-api-key
OKX_SECRET_KEY=your-okx-secret-key
OKX_PASSPHRASE=your-okx-passphrase
# CRITICAL: set to false for live trading (real funds), true for OKX demo server (simulated fills)
OKX_DEMO_MODE=false

# Binance API Credentials
BINANCE_API_KEY=your-binance-api-key
BINANCE_SECRET_KEY=your-binance-secret-key
BINANCE_TESTNET=true

# Bybit API Credentials
BYBIT_API_KEY=your-bybit-api-key
BYBIT_SECRET_KEY=your-bybit-secret-key
BYBIT_TESTNET=true

# Database
DATABASE_PATH=trading.db

# Anthropic API (required for post-trade AI analysis + auto-tune)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Telegram Notifications (optional)
# Create a bot via @BotFather, get your Chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
